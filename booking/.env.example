# Copy to .env for local development, or add these as Variables in Railway.

# --- Database (required) ---------------------------------------------------
# Supabase → Project Settings → Database → Connection string → "Session pooler"
# (IPv4-compatible, works from Railway). Replace [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres
# Local development without Supabase: comment out DATABASE_URL and use an
# embedded Postgres stored in this folder instead.
# LOCAL_DB_DIR=./.localdb

# --- Security (required) ---------------------------------------------------
# Shared password for the help desk page (/helpdesk). Use a long passphrase.
HELPDESK_PASSWORD=change-me-to-a-long-passphrase
# Random secret used to sign login cookies, e.g. output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Booking rules (optional, defaults shown) ------------------------------
# How many days ahead patients can book online.
BOOKING_WINDOW_DAYS=30
# Minimum notice before a slot (minutes) so the help desk can call first.
MIN_NOTICE_MINUTES=120
# Max upcoming pending/confirmed requests per phone number.
MAX_ACTIVE_PER_PHONE=3

# --- Clinic contact shown on the pages (optional) --------------------------
CLINIC_PHONE=010-968 1216
CLINIC_WHATSAPP=60109681216

# Railway sets PORT automatically.
# PORT=8080
